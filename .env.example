# Firebase web configuration: قيم تطبيق الويب العامة من إعدادات Firebase
FIREBASE_WEB_CONFIG={"apiKey":"YOUR_PUBLIC_WEB_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","appId":"YOUR_APP_ID"}
# بريد المالك البالغ. لا تضعه في ملفات الواجهة.
OWNER_EMAIL=owner@example.com
# على Google Cloud يفضل ربط هوية خدمة محدودة الصلاحيات واستخدام Application Default Credentials.
# محليًا فقط: مسار ملف بيانات اعتماد خارج المشروع، أو ضع JSON الحساب الخدمي في Secrets.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/service-account.json
# FIREBASE_SERVICE_ACCOUNT={...private server credential...}
PORT=3000
